{
  "name": "@jewellery/desktop",
  "version": "0.2.0",
  "private": true,
  "main": "dist-electron/main.cjs",
  "comment": "Electron. main/ is the composition root and may see everything; renderer/ is sandboxed React and may see neither persistence nor the filesystem. NOTE: no \"type\": \"module\" here on purpose \u00e2\u20ac\u201d vite-plugin-electron reads it to choose its output format, and both the main process and a sandboxed preload must be CommonJS.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win",
    "start": "electron ."
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@jewellery/application": "*",
    "@jewellery/domain": "*",
    "@jewellery/persistence": "*",
    "@jewellery/printing": "*",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.jewellery.app",
    "productName": "Gold Jewellery Manager",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Gold Jewellery Manager"
    },
    "extraMetadata": {
      "main": "dist-electron/main.cjs"
    },
    "electronVersion": "37.10.3"
  }
}
