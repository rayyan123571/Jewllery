{
  "name": "@jewellery/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "comment": "Electron. main/ is the composition root and may see everything; renderer/ is sandboxed React and may see neither persistence nor the filesystem.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@jewellery/application": "*",
    "@jewellery/domain": "*",
    "@jewellery/persistence": "*",
    "@jewellery/printing": "*",
    "better-sqlite3": "^13.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^26.0.0"
  },
  "build": {
    "appId": "com.jewellery.app",
    "productName": "Gold Jewellery Manager",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Gold Jewellery Manager"
    }
  }
}