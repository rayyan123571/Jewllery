# =========================================================================
# AL-HARAM GOLD JEWELLERS — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`. Do NOT run any prisma migration until these are set.
# =========================================================================

# Postgres connection string from Neon (pooled connection recommended).
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Auth.js secret. Generate with:  openssl rand -base64 32
AUTH_SECRET=

# Canonical URL of the app. Local dev: http://localhost:3000
AUTH_URL=http://localhost:3000
